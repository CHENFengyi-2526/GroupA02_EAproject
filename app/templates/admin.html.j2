{% extends "base.html.j2" %}

{% block title %}Admin Dashboard - ASP.NET Core{% endblock %}

{% block content %}
<div class="container my-4">
    <h2 class="mb-4">Admin Dashboard</h2>
    <div class="row g-4">
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-book fa-3x text-purple mb-3"></i><h5>Tutorials</h5><p class="small">Manage tutorials, categories, tags</p><a href="{{ url_for('tutorials.list_categories') }}" class="btn btn-sm btn-outline-purple">Manage</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-download fa-3x text-purple mb-3"></i><h5>Resources</h5><p class="small">Manage resources, categories</p><a href="{{ url_for('resources.list_categories') }}" class="btn btn-sm btn-outline-purple">Manage</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-users fa-3x text-purple mb-3"></i><h5>Users</h5><p class="small">Manage user accounts and roles</p><a href="{{ url_for('admin.list_users') }}" class="btn btn-sm btn-outline-purple">Manage</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-cog fa-3x text-purple mb-3"></i><h5>Roles</h5><p class="small">Manage roles</p><a href="{{ url_for('admin.list_roles') }}" class="btn btn-sm btn-outline-purple">Manage</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-user-friends fa-3x text-purple mb-3"></i><h5>Elderly Profiles</h5><p class="small">View elderly profiles</p><a href="{{ url_for('admin.list_elderly_profiles') }}" class="btn btn-sm btn-outline-purple">View</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-address-book fa-3x text-purple mb-3"></i><h5>Family Contacts</h5><p class="small">View family contacts</p><a href="{{ url_for('admin.list_family_contacts') }}" class="btn btn-sm btn-outline-purple">View</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-mobile-alt fa-3x text-purple mb-3"></i><h5>Devices</h5><p class="small">View user devices</p><a href="{{ url_for('admin.list_user_devices') }}" class="btn btn-sm btn-outline-purple">View</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-file-signature fa-3x text-purple mb-3"></i><h5>Consent Records</h5><p class="small">View consent records</p><a href="{{ url_for('admin.list_consent_records') }}" class="btn btn-sm btn-outline-purple">View</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-link fa-3x text-purple mb-3"></i><h5>Family Links</h5><p class="small">View family-elderly links</p><a href="{{ url_for('admin.list_family_elderly_links') }}" class="btn btn-sm btn-outline-purple">View</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-history fa-3x text-purple mb-3"></i><h5>Access Logs</h5><p class="small">View access logs</p><a href="{{ url_for('admin.list_access_logs') }}" class="btn btn-sm btn-outline-purple">View</a></div></div></div>
        <div class="col-md-6 col-lg-3"><div class="card text-center shadow-sm border-0 rounded-4"><div class="card-body"><i class="fas fa-sliders-h fa-3x text-purple mb-3"></i><h5>User Settings</h5><p class="small">View user settings</p><a href="{{ url_for('admin.list_user_settings') }}" class="btn btn-sm btn-outline-purple">View</a></div></div></div>
    </div>
</div>
{% endblock %}